; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be manually edited if needed.

config_version=5

[application]

config/name="Paleolithic Forge"
config/description="A paleolithic survival sandbox game"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[autoload]

GameManager="*res://autoload/GameManager.gd"
WorldGenerator="*res://autoload/WorldGenerator.gd"
TimeManager="*res://autoload/TimeManager.gd"
JobSystem="*res://autoload/JobSystem.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input]

